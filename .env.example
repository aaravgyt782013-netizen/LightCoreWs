# Public branding & Discord links (baked in as defaults in src/lib/site.ts)
# NOTE: Enter plain values WITHOUT surrounding quotes in Render / Vercel / Netlify dashboards.
NEXT_PUBLIC_SITE_NAME=LightCore
NEXT_PUBLIC_WORDMARK_LEAD=LIGHT
NEXT_PUBLIC_WORDMARK_ACCENT=CORE
NEXT_PUBLIC_SITE_TAGLINE=LIGHT FOR YOU HEAVY FOR NUKERS
NEXT_PUBLIC_SITE_DESCRIPTION=The all-in-one Discord security, moderation, voice, ticket & automation bot
NEXT_PUBLIC_SITE_URL=https://lightcorews.onrender.com
NEXT_PUBLIC_BOT_PREFIX=.
NEXT_PUBLIC_DISCORD_CLIENT_ID=1559607601115955210
NEXT_PUBLIC_OWNER_ID=1538907226671022111
# Strict read-only Discord OAuth 2.0 scopes (identify + guilds only)
NEXT_PUBLIC_DISCORD_OAUTH_SCOPES=identify guilds
NEXT_PUBLIC_DISCORD_INVITE_URL=https://discord.com/oauth2/authorize?client_id=1559607601115955210&permissions=8&integration_type=0&scope=bot%20applications.commands
NEXT_PUBLIC_DISCORD_SUPPORT_URL=https://discord.gg/vTPhtsncjH
NEXT_PUBLIC_DASHBOARD_URL=/dashboard
NEXT_PUBLIC_LOGO_URL=/brand/logo.png

# Optional Google Search Console verification token
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Owner access control (comma-separated Discord user IDs supported)
DISCORD_OWNER_ID=1538907226671022111

# Discord OAuth 2.0 login (server-only — never commit real secrets)
# Redirect URI is auto-detected from your live domain as: https://<your-domain>/api/auth/callback/discord
# Add that exact URL in Discord Developer Portal -> OAuth2 -> Redirects
DISCORD_CLIENT_SECRET=
SESSION_SECRET=
DISCORD_OAUTH_SCOPES=identify guilds
# Optional override (leave unset to auto-match your active domain):
# DISCORD_REDIRECT_URI=https://lightcorews.onrender.com/api/auth/callback/discord

# Discord Bot Token — powers live channel/role dropdowns, /admin server list, and /status telemetry
DISCORD_BOT_TOKEN=

# Optional Support Server ID & Role ID for syncing Premium badge roles to existing members
# DISCORD_SUPPORT_GUILD_ID=
# DISCORD_PREMIUM_ROLE_ID=

# Optional persistent local data directory (e.g. a Render Persistent Disk mounted at /var/data)
# LIGHTCORE_DATA_DIR=/var/data

# Optional external bot HTTP API for real-time sync between website & your Discord bot
# Exposes: GET/PUT /guilds/:id/config, GET /health, GET /logs
BOT_API_URL=
BOT_API_KEY=

# Live log ingestion & Discord channel webhook forwarding (server-only)
LOG_INGEST_SECRET=
DISCORD_LOG_WEBHOOK_URL=
