# Public branding & Discord links (baked in as defaults in src/lib/site.ts)
NEXT_PUBLIC_SITE_NAME=LightCore
NEXT_PUBLIC_WORDMARK_LEAD=LIGHT
NEXT_PUBLIC_WORDMARK_ACCENT=CORE
NEXT_PUBLIC_SITE_TAGLINE="LIGHT FOR YOU HEAVY FOR NUKERS"
NEXT_PUBLIC_SITE_DESCRIPTION="As your choice for an all in one bot"
NEXT_PUBLIC_SITE_URL=https://lightcorews.wasmer.app
NEXT_PUBLIC_BOT_PREFIX=.
NEXT_PUBLIC_DISCORD_CLIENT_ID=1559607601115955210
NEXT_PUBLIC_OWNER_ID=1538907226671022111
NEXT_PUBLIC_DISCORD_OAUTH_SCOPES="identify email guilds guilds.join"
NEXT_PUBLIC_DISCORD_INVITE_URL="https://discord.com/oauth2/authorize?client_id=1559607601115955210&permissions=8&integration_type=0&scope=bot"
NEXT_PUBLIC_DISCORD_SUPPORT_URL=https://discord.gg/np8M2TZgqa
NEXT_PUBLIC_DASHBOARD_URL=/login
NEXT_PUBLIC_LOGO_URL=/brand/logo.png

# Owner access control (comma-separated Discord user IDs supported)
DISCORD_OWNER_ID=1538907226671022111

# Discord OAuth2 login (server-only — never commit real secrets)
# Redirect URI in Discord Developer Portal: https://lightcorews.wasmer.app/api/auth/callback/discord
DISCORD_CLIENT_SECRET=
SESSION_SECRET=
DISCORD_OAUTH_SCOPES="identify email guilds guilds.join"
# DISCORD_REDIRECT_URI=https://lightcorews.wasmer.app/api/auth/callback/discord

# Bot token & optional auto-join server on login (requires bot in that guild + guilds.join scope)
DISCORD_BOT_TOKEN=
DISCORD_AUTO_JOIN_GUILD_ID=

# Optional Discord Role ID automatically granted to Premium users (can also be edited in /admin)
# DISCORD_PREMIUM_ROLE_ID=

# Optional external bot HTTP API for real-time sync between website & your Discord bot
# Exposes: GET/PUT /guilds/:id/config, GET /health, GET /logs, POST /oauth-users
# Leave blank if your bot doesn't expose an HTTP API yet — dashboard works without it.
BOT_API_URL=
BOT_API_KEY=

# Live log ingestion & Discord channel webhook forwarding (server-only)
LOG_INGEST_SECRET=
DISCORD_LOG_WEBHOOK_URL=
